# Copy this file to .env and adjust if your PostgreSQL settings differ.
# On most Windows installs the only value you may change is PGPASSWORD.

# --- PostgreSQL connection ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=qrius_leads

# --- API server ---
PORT=3000

# --- Auth ---
# Any long random string. Do not share a real one outside training.
JWT_SECRET=qrius-training-secret-change-me
